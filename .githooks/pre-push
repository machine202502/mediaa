#!/bin/sh
root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root" || exit 1
command -v cargo >/dev/null 2>&1 || {
    echo "pre-push: cargo not found; refusing to push an unverified tree" >&2
    exit 1
}
cargo fmt --all -- --check || {
    echo "pre-push: the tree is not formatted; run cargo fmt --all and commit the result" >&2
    exit 1
}
command -v node >/dev/null 2>&1 || {
    echo "git-consent: node not found; refusing push without the consent hook" >&2
    exit 1
}
exec node "$root/scripts/git-consent.mjs" check push
